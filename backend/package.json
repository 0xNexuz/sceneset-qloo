  "devDependencies": {
    "@types/node": "24.x",
    "just-bash": "^3.6.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.3"
  },
  "overrides": {
    "guarded-fetch": {
      "undici": "7.30.1"
